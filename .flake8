[flake8]
max-line-length = 100
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    build,
    dist,
    *.egg-info,
    .eggs,
    .tox,
    .venv,
    venv,
    .env,
    docs
per-file-ignores =
    __init__.py: F401
    tests/*: E501
max-complexity = 10
statistics = True
count = True

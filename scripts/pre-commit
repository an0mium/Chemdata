#!/bin/bash
set -e

# Activate virtual environment if it exists
if [ -d "venv" ]; then
    source venv/bin/activate
fi

# Get list of staged Python files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d | grep ".py$" || true)

if [ -n "$STAGED_FILES" ]; then
    echo "Running pre-commit checks on staged Python files..."
    
    # Format code
    echo "Running black..."
    black --config=setup.cfg $STAGED_FILES
    
    # Sort imports
    echo "Running isort..."
    isort --settings-path=setup.cfg $STAGED_FILES
    
    # Run flake8
    echo "Running flake8..."
    flake8 --config=setup.cfg $STAGED_FILES
    
    # Run mypy
    echo "Running mypy..."
    mypy --config-file=setup.cfg $STAGED_FILES
    
    # Run bandit security checks
    echo "Running bandit..."
    bandit --configfile=.bandit.yaml -r $STAGED_FILES
    
    # Run pytest on affected modules
    echo "Running tests..."
    AFFECTED_MODULES=$(echo "$STAGED_FILES" | sed -n 's/binding_data_processor\/\([^/]*\)\/.*/\1/p' | sort -u)
    if [ -n "$AFFECTED_MODULES" ]; then
        for module in $AFFECTED_MODULES; do
            pytest --config=setup.cfg "tests/$module"
        done
    fi
    
    # Add back the formatted files
    git add $STAGED_FILES
fi

# Check for sensitive data
echo "Checking for sensitive data..."
if git diff --cached | grep -i "password\|secret\|key\|token\|credential"; then
    echo "Warning: Possible sensitive data detected in changes"
    echo "Please review the changes carefully before committing"
    read -p "Do you want to continue? (y/N) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        exit 1
    fi
fi

# Deactivate virtual environment if it was activated
if [ -d "venv" ]; then
    deactivate
fi
